{
  "name": "gaff3r",
  "private": true,
  "scripts": {
    "dev:worker": "npm run wrangler -- dev --config worker/wrangler.toml",
    "dev:frontend": "npm --prefix frontend run dev",
    "deploy": "npm run wrangler -- deploy --config worker/wrangler.toml",
    "deploy:dry": "npm run wrangler -- deploy --dry-run --config worker/wrangler.toml",
    "d1": "npm run wrangler -- d1 --config worker/wrangler.toml",
    "secret:put": "npm run wrangler -- secret put --config worker/wrangler.toml",
    "secret:list": "npm run wrangler -- secret list --config worker/wrangler.toml",
    "tail": "npm run wrangler -- tail --config worker/wrangler.toml",
    "wrangler": "npx wrangler",
    "test:worker": "npm --prefix worker test",
    "test:frontend": "npm --prefix frontend test"
  },
  "devDependencies": {
    "wrangler": "^4.78.0"
  },
  "dependencies": {
    "@better-auth/infra": "^0.1.13"
  }
}
